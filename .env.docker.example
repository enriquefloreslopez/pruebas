# Copia este archivo como .env junto a docker-compose.yml y llena los valores.

# --- Básico ---
# Dirección pública del sitio (la que configuraste en el túnel de Cloudflare).
NEXT_PUBLIC_SITE_URL=https://citas.tudominio.com
# WhatsApp de contacto, con código de país y solo dígitos.
NEXT_PUBLIC_WHATSAPP_NUMBER=524641011451
OWNER_EMAIL=

# Contraseña de la base de datos: solo letras y números, larga y al azar.
POSTGRES_PASSWORD=

# Llaves del panel y de la administración (textos largos al azar).
PANEL_SECRET=
ADMIN_KEY=

# Token del túnel: Cloudflare Zero Trust > Networks > Tunnels > tu túnel > Install connector.
CLOUDFLARE_TUNNEL_TOKEN=

# --- Pagos y correos ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_SEGMENT_ID=

# --- Solo para un equipo dentro de un negocio (dejar vacío en la nube) ---
# Muestra únicamente la página de este negocio.
SOLO_NEGOCIO=
# true = la agenda y la administración solo abren desde la red del local, nunca desde internet.
PANEL_SOLO_LOCAL=
# 0.0.0.0 = los equipos de la red del local pueden abrir la agenda en http://IP-DEL-EQUIPO:3000
APP_BIND=127.0.0.1
