# Copia este archivo como .env.local para desarrollo y pon los mismos valores
# en Vercel > Project > Settings > Environment Variables.

# URL pública del sitio (sin "/" al final). Ej: https://citalista.vercel.app
NEXT_PUBLIC_SITE_URL=

# Tu WhatsApp con código de país, solo dígitos. Ej: 5213312345678
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Correo donde te llegan los avisos de citas y de ventas.
OWNER_EMAIL=

# Stripe > Developers > API keys (usa sk_test_... mientras pruebas).
STRIPE_SECRET_KEY=
# Stripe > Developers > Webhooks > tu endpoint > Signing secret (whsec_...).
STRIPE_WEBHOOK_SECRET=

# Resend > API Keys.
RESEND_API_KEY=
# Remitente con tu dominio verificado en Resend. Ej: CitaLista <hola@citalista.mx>
RESEND_FROM_EMAIL=
# Opcional: ID del segmento de Resend donde se guardan los suscriptores del boletín.
RESEND_SEGMENT_ID=

# Base de datos de citas (Postgres). En Vercel se llena sola al agregar Neon desde Storage.
DATABASE_URL=
# Secreto para generar el link privado del panel de cada negocio (texto largo al azar).
PANEL_SECRET=
# Llave del panel de administración: entra en /admin?k=TU_LLAVE
ADMIN_KEY=
